    "components":  [
                       {
                           "name":  "Report Panel",
                           "kind":  "card",
                           "refersTo":  "report-panel",
                           "description":  "A flat report surface for the daily breakdown, charts, and summaries.",
                           "html":  "\u003carticle class=\"ds-report-panel\"\u003e\u003ch2\u003eDaily breakdown\u003c/h2\u003e\u003cp\u003eStrategy results for the selected report date.\u003c/p\u003e\u003c/article\u003e",
                           "css":  ".ds-report-panel { background: #fff; color: #19272d; border: 1px solid #dce3e1; border-radius: 20px; padding: clamp(1rem, 2vw, 1.5rem); } .ds-report-panel h2 { margin: 0; font: 700 1.45rem/1.2 Archivo, sans-serif; letter-spacing: -0.02em; } .ds-report-panel p { color: #617176; font-family: inherit; font-size: 0.75rem; font-weight: 400; line-height: 1.5; }"
                       },
                       {
                           "name":  "Strategy Navigation Rail",
                           "kind":  "nav",
                           "refersTo":  "sidebar",
                           "description":  "A data-driven strategy rail on wide screens, with a clear selected row.",
                           "html":  "\u003cnav class=\"ds-strategy-nav\" aria-label=\"Strategies\"\u003e\u003cp\u003eStrategies\u003c/p\u003e\u003cbutton class=\"ds-nav-item\" aria-pressed=\"true\"\u003eAll strategies\u003c/button\u003e\u003cbutton class=\"ds-nav-item\" aria-pressed=\"false\"\u003eStrategy name\u003c/button\u003e\u003c/nav\u003e",
                           "css":  ".ds-strategy-nav { width: clamp(17rem, 20vw, 20rem); min-height: 18rem; padding: 1.25rem; background: #14212a; color: #fff; font-family: inherit; font-size: 0.875rem; font-weight: 500; line-height: 1.4; } .ds-strategy-nav p { color: #91a99a; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; } .ds-nav-item { display: block; width: 100%; min-height: 44px; margin-top: 0.5rem; padding: 0.625rem 0.75rem; border: 0; border-radius: 12px; background: transparent; color: #c0cec4; text-align: left; transition: background 150ms ease-out, color 150ms ease-out; } .ds-nav-item:hover { background: rgba(255,255,255,0.06); color: #fff; } .ds-nav-item[aria-pressed=true] { background: #203d43; box-shadow: inset 2px 0 #8de0c3; color: #fff; } .ds-nav-item:focus-visible { outline: 2px solid #8de0c3; outline-offset: 2px; }"
                       },
                       {
                           "name":  "Date Range Control",
                           "kind":  "custom",
                           "refersTo":  "date-range-control",
                           "description":  "The report date and selected range share one calendar trigger; amber is limited to the icon chip.",
                           "html":  "\u003cbutton class=\"ds-date-range\" type=\"button\" aria-label=\"Select date range\"\u003e\u003cspan class=\"ds-date-icon\" aria-hidden=\"true\"\u003e\u003csvg viewBox=\"0 0 24 24\"\u003e\u003crect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"\u003e\u003c/rect\u003e\u003cpath d=\"M16 3v4M8 3v4M3 11h18\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/span\u003e\u003cspan\u003e\u003cstrong\u003e12 Oct 2026\u003c/strong\u003e\u003csmall\u003eAll dates\u003c/small\u003e\u003c/span\u003e\u003c/button\u003e",
                           "css":  ".ds-date-range { display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border: 1px solid #d2dcda; border-radius: 12px; background: #fff; color: #19272d; text-align: left; transition: border-color 150ms ease-out; } .ds-date-range:hover { background: #fff; } .ds-date-range:focus-visible { outline: 2px solid #137b80; outline-offset: 2px; } .ds-date-icon { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border-radius: 8px; background: #f7efd9; color: #91651b; } .ds-date-icon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; } .ds-date-range strong { display: block; color: #24383d; font: 700 0.875rem/1.25 IBM Plex Mono, monospace; } .ds-date-range small { display: block; color: #617176; font-family: inherit; font-size: 0.625rem; font-weight: 500; line-height: 1.4; }"
                       },
                       {
                           "name":  "Selected Weekday",
                           "kind":  "chip",
                           "refersTo":  "weekday-chip-selected",
                           "description":  "A selected weekday filter or report-date marker.",
                           "html":  "\u003cbutton class=\"ds-weekday-selected\" aria-pressed=\"true\"\u003eM\u003c/button\u003e",
                           "css":  ".ds-weekday-selected { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border: 1px solid #137b80; border-radius: 9999px; background: #137b80; color: #fff; font: 500 0.75rem/1 IBM Plex Mono, monospace; transition: transform 150ms ease-out, background 150ms ease-out; } .ds-weekday-selected:hover { transform: translateY(-2px); } .ds-weekday-selected:active { transform: scale(0.9); } .ds-weekday-selected:focus-visible { outline: 2px solid #137b80; outline-offset: 2px; }"
                       },
                       {
                           "name":  "Unselected Weekday",
                           "kind":  "chip",
                           "refersTo":  "weekday-chip",
                           "description":  "An available day in the weekday filter.",
                           "html":  "\u003cbutton class=\"ds-weekday\" aria-pressed=\"false\"\u003eT\u003c/button\u003e",
                           "css":  ".ds-weekday { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border: 1px solid #a9d1c9; border-radius: 9999px; background: #ecf6f3; color: #176b70; font: 500 0.75rem/1 IBM Plex Mono, monospace; transition: transform 150ms ease-out, background 150ms ease-out; } .ds-weekday:hover { background: #ecf6f3; transform: translateY(-2px); } .ds-weekday:active { transform: scale(0.9); } .ds-weekday:focus-visible { outline: 2px solid #137b80; outline-offset: 2px; }"
                       },
                       {
                           "name":  "EOD Status Badge",
                           "kind":  "chip",
                           "refersTo":  "status-badge",
                           "description":  "A compact end-of-day report status beside the date control.",
                           "html":  "\u003cspan class=\"ds-status\" role=\"status\"\u003e\u003ci aria-hidden=\"true\"\u003e\u003c/i\u003eEOD Report\u003c/span\u003e",
                           "css":  ".ds-status { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border: 1px solid #cce7d5; border-radius: 9999px; background: #e9f5ed; color: #176b49; font-family: inherit; font-size: 0.75rem; font-weight: 700; line-height: 1.2; } .ds-status i { width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: #21875d; }"
                       },
                       {
                           "name":  "Contact Action",
                           "kind":  "button",
                           "refersTo":  "action-button",
                           "description":  "The report contact action uses a green fill and a darker hover state.",
                           "html":  "\u003ca class=\"ds-action\" href=\"#\"\u003eContact\u003c/a\u003e",
                           "css":  ".ds-action { display: inline-flex; min-height: 44px; align-items: center; gap: 0.375rem; padding: 0.625rem 1rem; border-radius: 12px; background: #1c7c55; color: #fff; font-family: inherit; font-size: 0.875rem; font-weight: 700; line-height: 1.2; text-decoration: none; transition: background 150ms ease-out; } .ds-action:hover { background: #176b49; } .ds-action:focus-visible { outline: 2px solid #137b80; outline-offset: 2px; }"
                       },
                       {
                           "name":  "Lot Selector",
                           "kind":  "input",
                           "refersTo":  "lot-select",
                           "description":  "A native select next to each strategy, with a compact responsive variant.",
                           "html":  "\u003clabel class=\"ds-lot\"\u003eLot\u003cselect aria-label=\"Strategy lot size\"\u003e\u003coption\u003e1x\u003c/option\u003e\u003coption\u003e2x\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e",
                           "css":  ".ds-lot { display: grid; gap: 0.25rem; color: #68797d; font-family: inherit; font-size: 0.625rem; font-weight: 500; line-height: 1.3; } .ds-lot select { max-width: 100%; min-height: 44px; padding: 0.5rem 0.75rem; border: 1px solid #d9e3d9; border-radius: 8px; background: #fff; color: #24383d; font-family: inherit; font-size: 0.875rem; font-weight: 600; line-height: 1.3; } .ds-lot select:focus-visible { outline: 2px solid #137b80; outline-offset: 2px; }"
                       }
                   ],
    "narrative":  {
                      "northStar":  "The Exchange Close Report",
                      "overview":  "The public tracker follows the rhythm of an exchange-close report: the header leads directly into the daily strategy breakdown, where scheduled days, lot size, capital, and period results sit side by side.\n\nMineral paper and deep ink keep the page quiet while the data leads. Archivo headings, tabular IBM Plex Mono values, teal controls, green and red performance signals, and a restrained amber report-date marker distinguish structure and state. This visual system is scoped to the public tracker and preserves the production feed as its source of figures.",
                      "keyCharacteristics":  [
                                                 "Daily strategy breakdown leads; supporting charts and summaries follow.",
                                                 "Mineral paper, deep ink navigation, teal selection, green/red P\u0026L, and an amber date marker.",
                                                 "Archivo headings pair with tabular IBM Plex Mono financial values.",
                                                 "Strategy, lot, date, weekday, chart, and summary behavior remains data-driven."
                                             ],
                      "rules":  [
                                    {
                                        "name":  "The Signal Roles Rule",
                                        "body":  "Teal marks selection and focus, green and red carry P\u0026L direction, and amber stays with the report date.",
                                        "section":  "colors"
                                    },
                                    {
                                        "name":  "The Number Rule",
                                        "body":  "Financial values use IBM Plex Mono and tabular numerals so columns stay aligned.",
                                        "section":  "typography"
                                    },
                                    {
                                        "name":  "The Flat Surface Rule",
                                        "body":  "Keep report panels flat; reserve soft lift for overlays and the compact strategy menu.",
                                        "section":  "elevation"
                                    }
                                ],
                      "dos":  [
                                  "Do keep every report value readable at narrow widths and preserve its source data.",
                                  "Do use the selected date range, weekday filters, and lot sizes consistently across the report.",
                                  "Do retain loading, error, and empty states for the production API.",
                                  "Do keep financial figures tabular and strategy rows data-driven."
                              ],
                      "donts":  [
                                    "Don\u0027t hardcode strategy rows, performance claims, or placeholder metrics into the live tracker.",
                                    "Don\u0027t use heavy shadows, decorative gradients, or extra color accents that compete with the data."
                                ]
                  }
}
